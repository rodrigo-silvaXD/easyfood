# ----------------------------------------------------------
# EasyFood - variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# ----------------------------------------------------------

# Conexão com o PostgreSQL
# Local (instalação nativa):
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/easyfood"
# Docker (docker compose up -d):
# DATABASE_URL="postgresql://easyfood:easyfood@localhost:5432/easyfood"

# Chave usada para assinar os tokens JWT.
# Gere a sua com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Validade do token
JWT_EXPIRES_IN="1d"

# Porta da aplicação
PORT=3000
