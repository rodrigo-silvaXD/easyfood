# ----------------------------------------------------------
# EasyFood — variáveis de ambiente
# Copie este arquivo para .env:   cp .env.example .env
# ----------------------------------------------------------

# --- Banco de dados ---------------------------------------
# Padrão: PostgreSQL do docker-compose.yml deste projeto.
#   docker compose up -d
DATABASE_URL="postgresql://easyfood:easyfood@localhost:5432/easyfood"

# PostgreSQL instalado na máquina (troque a senha e crie o banco easyfood):
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/easyfood"

# Sem Docker e sem instalar nada — o Prisma sobe um Postgres local:
#   npx prisma dev -n easyfood -d
# Use a porta que o comando imprimir:
# DATABASE_URL="postgresql://postgres:postgres@localhost:PORTA/template1?sslmode=disable&pgbouncer=true"

# --- Autenticação -----------------------------------------
# Chave usada para assinar os tokens JWT. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Validade do token
JWT_EXPIRES_IN="1d"

# --- Aplicação --------------------------------------------
PORT=3000
